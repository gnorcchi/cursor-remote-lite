{
  "name": "cursor-remote-lite",
  "version": "1.0.0",
  "description": "Use your desktop Cursor from your phone: chat with the Agent, approve steps, switch windows/modes/models. Free and self-hosted.",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "setup": "node setup.mjs",
    "start": "node server.mjs",
    "public": "node server.mjs --tunnel",
    "pair": "node devices.mjs pair",
    "devices": "node devices.mjs",
    "2fa": "node twofa.mjs",
    "reset": "node devices.mjs reset"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cursor",
    "remote",
    "mobile",
    "cdp",
    "agent",
    "pwa"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  }
}
